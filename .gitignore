log*.txt
*coverage_summary*.txt

# arrays/images saved with an empty filename
.npy
.png

# Images but keep .png files in general
*.jpg
*.jpeg

# xml files
*.xml
!cases/*/model/*.xml
!tests/test_products/**/*.xml

