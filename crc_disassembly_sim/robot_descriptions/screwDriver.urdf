<?xml version="1.0" ?>
<robot name="screwdriver_new">
  <link name="baseLink">
  </link>
  <link name="screwdriver">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
			<mesh filename="screwdriver/mesh/screwdriver.stl" scale="0.001 0.001 0.001"/>
      </geometry>
       <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
		<collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
			<mesh filename="screwdriver/mesh/screwdriver.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </collision>
	</link>
  <link name="tcp">
    <visual>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
        <geometry>
           <sphere radius="0.005"/>
        </geometry>
        <material name="black">
            <color rgba="0.0 0.5 0.0 1.0"/>
        </material>
    </visual>
  </link>
    
  <joint name="screwdriver_joint" type="fixed">
		<parent link="baseLink"/>
		<child link="screwdriver"/>
		<origin rpy="0 0 1.5707963267948966" xyz="0 0 -0.0525"/>
  </joint>
  
  <joint name="gripping_trafo" type="fixed">
		<parent link="screwdriver"/>
		<child link="tcp"/>
		<origin xyz="0.0 0.218 -0.033" rpy="1.5707963267948966 3.1415926535897932 0"/>
  </joint>
</robot>