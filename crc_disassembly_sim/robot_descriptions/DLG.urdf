<?xml version="1.0" ?>
<robot name="SRG">
  <link name="baseLink">
  </link>
  <link name="body">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.001"/>
       <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 3.14159265358979323846264338 -1.5707963267948966192313216916" xyz="0 0.0 0.0"/>
      <geometry>
			<mesh filename="tool_mesh/DLG_fix.stl" scale="0.001 0.001 0.001"/>
      </geometry>
       <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>
  <link name="static_finger">
    <contact>
      <stiffness value="1000.0"/>
      <damping value="10.0"/>
      <spinning_friction value="1"/>
      <lateral_friction value="1"/>
      <rolling_friction value="1" />
      <contact_cfm value="100"/>
      <contact_erp value="100"/>
    </contact>
  	<inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.1"/>
       <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin rpy="0 3.14159265358979323846264338 -1.5707963267948966192313216916" xyz="0.0 0.0 0.0"/>
      <geometry>
			<mesh filename="tool_mesh/DLG_fix_finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 3.14159265358979323846264338 -1.5707963267948966192313216916" xyz="0.0 0 0.0"/>
      <geometry>
			<mesh filename="tool_mesh/DLG_fix_finger_coll.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </collision>
  </link>
  <link name="mobile_finger">
    <contact>
      <stiffness value="1000.0"/>
      <damping value="10.0"/>
      <spinning_friction value="1"/>
      <lateral_friction value="1"/>
      <rolling_friction value="1" />
      <contact_cfm value="100"/>
      <contact_erp value="100"/>
    </contact>
  	<inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.1"/>
       <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin rpy="0 3.14159265358979323846264338 -1.5707963267948966192313216916" xyz="0.0 0.0 0.0"/>
      <geometry>
			<mesh filename="tool_mesh/DLG_mobile.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 3.14159265358979323846264338 -1.5707963267948966192313216916" xyz="0.0 0.0 0.0"/>
      <geometry>
			<mesh filename="tool_mesh/DLG_mobile_coll.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </collision>
  </link>
  <joint name="docking_trafo" type="fixed">
		<parent link="baseLink"/>
		<child link="body"/>
		<origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="fixed_finger_link" type="fixed">
		<parent link="baseLink"/>
		<child link="static_finger"/>
		<origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="finger_joint" type="prismatic">
    <parent link="body"/>
    <child link="mobile_finger"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="0.001" lower="-0.2" upper="0.0" velocity="0.2"/>
  </joint>
  <joint name="gripping_trafo" type="fixed">
		<parent link="static_finger"/>
		<child link="tcp"/>
		<origin xyz=" -0.1475 0.0 -0.3685" rpy="0 0 0"/>
  </joint>

  <link name="tcp">
    <visual>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
        <geometry>
           <sphere radius="0.005"/>
        </geometry>
        <material name="red">
            <color rgba="0.5 0.0 0.0 1.0"/>
        </material>
    </visual>
  </link>
</robot>
