<?xml version="1.0" ?>
<robot name="SRG">
  <link name="baseLink">
  </link>
  <link name="sws_toolside">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
			<mesh filename="EEF-addon/SWA.stl" scale="0.001 0.001 0.001"/>
      </geometry>
       <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>		
	</link>
  <link name="adapter_robotside">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.001"/>
       <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
			<mesh filename="gripper/mesh/Adapterplatte_Greifer_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
       <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>
  <link name="adapter_gripperbase">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.001"/>
       <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
			<mesh filename="gripper/mesh/Adapterplatte_Greifer_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
       <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>
  <link name="body">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.001"/>
       <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
			<mesh filename="gripper/mesh/EGU_70_PN.stl" scale="0.001 0.001 0.001"/>
      </geometry>
       <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>
  <link name="leftfinger">
    <contact>
      <stiffness value="1000.0"/>
      <damping value="10.0"/>
      <spinning_friction value="1"/>
      <lateral_friction value="1"/>
      <rolling_friction value="1" />
      <contact_cfm value="100"/>
      <contact_erp value="100"/>
    </contact>
  	<inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.1"/>
       <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
			<mesh filename="gripper/mesh/initialesfingerset_gg_tr_v2_bg.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.0 0 0.0"/>
      <geometry>
			<mesh filename="gripper/mesh/initialesfingerset_gg_tr_v2_bg.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </collision>
  </link>
  <link name="rightfinger">
    <contact>
      <stiffness value="1000.0"/>
      <damping value="10.0"/>
      <spinning_friction value="1"/>
      <lateral_friction value="1"/>
      <rolling_friction value="1" />
      <contact_cfm value="100"/>
      <contact_erp value="100"/>
    </contact>
  	<inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.1"/>
       <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <geometry>
			<mesh filename="gripper/mesh/initialesfingerset_gg_tr_v2_bg.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0.0 0 0.0"/>
      <geometry>
			<mesh filename="gripper/mesh/initialesfingerset_gg_tr_v2_bg.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </collision>
  </link>
  <link name="tcp">
    <visual>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
        <geometry>
           <sphere radius="0.005"/>
        </geometry>
        <material name="black">
            <color rgba="0.0 0.5 0.0 1.0"/>
        </material>
    </visual>
  </link>


  <joint name="SWA-toolside" type="fixed">
		<parent link="baseLink"/>
		<child link="sws_toolside"/>
		<origin rpy="0 0 3.1415926535897932" xyz="0 0 0"/>
  </joint>
  <joint name="adapter_joint_robotside" type="fixed">
    <parent link="sws_toolside"/>
    <child link="adapter_robotside"/>
    <origin rpy="0 0 0" xyz="0 0 -0.0536"/>
  </joint>
  <joint name="adapter_joint_gripperside" type="fixed">
    <parent link="adapter_robotside"/>
    <child link="adapter_gripperbase"/>
    <origin rpy="0 0 0" xyz="0 0 -0.014"/>
  </joint>
  <joint name="docking_trafo" type="fixed">
		<parent link="adapter_gripperbase"/>
		<child link="body"/>
		<origin rpy="3.1415926535897932 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="finger_joint1" type="prismatic">
    <parent link="body"/>
    <child link="leftfinger"/>
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 -0.008 0.1225"/>
    <axis xyz="-1 0 0"/>
    <limit effort="0.0001" lower="-0.07" upper="-0.015" velocity="0.2"/>
  </joint>
  <joint name="finger_joint2" type="prismatic">
    <parent link="body"/>
    <child link="rightfinger"/>
    <origin rpy="1.5707963267948966 0 -1.5707963267948966" xyz="0 0.008 0.1225"/>
    <axis xyz="-1 0 0"/>
    <limit effort="0.0001" lower="-0.07" upper="-0.015" velocity="0.2"/>
    <mimic joint="finger_joint1"/>
  </joint>
  <joint name="gripping_trafo" type="fixed">
		<parent link="baseLink"/>
		<child link="tcp"/>
		<origin xyz="0 0.0 -0.29" rpy="0 0 0"/>
  </joint>
</robot>
